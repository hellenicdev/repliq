# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=dialogue_video

# Cloudflare Turnstile (required once you create keys)
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCED=true
# Turnstile site key goes in frontend/.env as VITE_TURNSTILE_SITE_KEY

# FFmpeg (optional; defaults to `ffmpeg` on PATH)
FFMPEG_PATH=

# Media / storage
MEDIA_ROOT=media
STORAGE_BACKEND=local

# CORS: comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generation limits
MAX_CLIPS=12
MAX_TOTAL_DURATION=30.0
OUTPUT_WIDTH=640
OUTPUT_HEIGHT=360
OUTPUT_FPS=24

# S3-compatible object storage (optional; skip to keep STORAGE_BACKEND=local)
# Provider: b2 (Backblaze B2) | r2 (Cloudflare R2) | custom (any S3 endpoint)
S3_PROVIDER=
# For r2: https://<account_id>.r2.cloudflarestorage.com
# For b2: https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
# For r2 use "auto"; for b2 use your bucket region (e.g. eu-central-003)
S3_REGION=
# For r2: virtual | b2: path (leave empty for auto)
S3_ADDRESSING_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
